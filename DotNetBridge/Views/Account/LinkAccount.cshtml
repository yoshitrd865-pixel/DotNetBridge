@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>アカウント紐付け - DotNetBridge</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; 
            display: flex; justify-content: center; align-items: center; 
            min-height: 100vh; background: #f4f6f9; margin: 0; padding: 1rem;
        }
        .card { 
            background: white; padding: 2.5rem 2rem; border-radius: 12px; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.08); width: 100%; max-width: 400px; 
        }
        h2 { margin-top: 0; margin-bottom: 0.5rem; text-align: center; color: #333; font-size: 1.4rem; }
        p.desc { font-size: 0.88rem; color: #666; text-align: center; margin-bottom: 1.5rem; line-height: 1.4; }
        .field { margin-bottom: 1.2rem; }
        label { display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #555; }
        input[type="text"], input[type="password"] { 
            width: 100%; padding: 0.75rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 6px; 
        }
        input:focus { outline: none; border-color: #007bff; }
        button { 
            width: 100%; padding: 0.8rem; background: #28a745; color: white; border: none; 
            border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: bold; margin-top: 0.5rem;
        }
        button:hover { background: #218838; }
        .error { color: #dc3545; font-size: 0.88rem; margin-bottom: 1rem; text-align: center; }
    </style>
</head>
<body>
    <div class="card">
        <h2>初回アカウント連携</h2>
        <p class="desc">業務システムを利用するために、上流システム（エコマスター等）のログインIDとパスワードを紐付けてください。</p>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/LinkAccount">
            <div class="field">
                <label>連携システム ID</label>
                <input type="text" name="legacyUserId" required placeholder="例: user1234" autofocus />
            </div>
            <div class="field">
                <label>連携システム パスワード</label>
                <input type="password" name="legacyPassword" required />
            </div>
            <button type="submit">連携してログイン</button>
        </form>
    </div>
</body>
</html>