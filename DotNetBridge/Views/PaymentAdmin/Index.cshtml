@model IEnumerable<DotNetBridge.Data.PaymentLog>

@{
    ViewData["Title"] = "売上請求・Stripe決済・PDFアーカイブ管理";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>💳 請求・決済・PDFアーカイブ統合管理</h2>
        <a href="/admin/payments" class="btn btn-outline-primary btn-sm">最新情報に更新</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>日時（発行 / 決済）</th>
                        <th>伝票番号</th>
                        <th>顧客コード</th>
                        <th>お施主様名</th>
                        <th class="text-end">請求金額</th>
                        <th>発行担当</th>
                        <th class="text-center">ステータス</th>
                        <th class="text-center">請求書PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Id</td>
                                <td>
                                    <small class="text-muted d-block">発行: @(log.IssuedAt != default ? log.IssuedAt.ToString("yyyy/MM/dd HH:mm") : "-")</small>
                                    <small class="fw-bold">決済: @(log.PaidAt != default ? log.PaidAt.ToString("yyyy/MM/dd HH:mm") : "-")</small>
                                </td>
                                <td><span class="badge bg-primary fs-6">@log.InvoiceNo</span></td>
                                <td><span class="badge bg-secondary fs-6">@log.CustomerCode</span></td>
                                <td class="fw-bold">@(string.IsNullOrEmpty(log.CustomerName) ? "お施主様" : log.CustomerName)</td>
                                <td class="text-end fw-bold text-success">¥@log.Amount.ToString("#,0")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        👤 @(string.IsNullOrEmpty(log.IssuedBy) ? "未指定" : log.IssuedBy)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (log.Status == "unpaid")
                                    {
                                        <span class="badge bg-secondary">● 未決済</span>
                                    }
                                    else if (log.Status == "completed" || log.Status == "PAID")
                                    {
                                        <span class="badge bg-warning text-dark">● Stripe決済済 (消込待機)</span>
                                    }
                                    else if (log.Status == "processed")
                                    {
                                        <span class="badge bg-success">✅ エコプロ消込完了</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">@log.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(log.PdfFileName))
                                    {
                                        <a href="/api/PdfArchive/view/@log.PdfFileName" target="_blank" class="btn btn-sm btn-outline-danger">
                                            📄 PDF表示
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">未保存</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                登録済みのデータがありません。
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>