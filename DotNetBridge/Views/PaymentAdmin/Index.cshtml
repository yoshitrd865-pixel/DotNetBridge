@model IEnumerable<DotNetBridge.Data.PaymentLog>

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stripe 決済消込管理</title>
    <!-- Bootstrap 5 を読み込んで見やすく装飾 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light p-4">
    <div class="container bg-white p-4 rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 m-0">💳 Stripe 入金消込管理リスト</h2>
            <button onclick="location.reload()" class="btn btn-sm btn-outline-secondary">最新情報に更新</button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>決済日時</th>
                        <th>顧客コード</th>
                        <th>伝票番号</th>
                        <th>決済金額</th>
                        <th>ステータス</th>
                        <th>Stripe Session ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">まだ決済データはありません</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.PaidAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                                <td>
                                    <span class="badge bg-secondary font-monospace">@item.CustomerCode</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary font-monospace fs-6">@item.InvoiceNo</span>
                                </td>
                                <td>
                                    <strong>¥@item.Amount.ToString("N0")</strong>
                                </td>
                                <td>
                                    @if (item.Status == "completed" || item.Status == "PAID")
                                    {
                                        <span class="badge bg-warning text-dark">未消込 (待機中)</span>
                                    }
                                    else if (item.Status == "processed")
                                    {
                                        <span class="badge bg-success">消込完了</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted font-monospace">@item.StripeSessionId</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>