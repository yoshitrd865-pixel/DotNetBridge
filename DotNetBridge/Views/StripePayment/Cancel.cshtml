@{
    Layout = null;
    ViewData["Title"] = "決済キャンセル";
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #f8f9fa; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        .card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: center; max-width: 480px; width: 90%; }
        .icon { font-size: 48px; color: #dc3545; margin-bottom: 16px; }
        h1 { font-size: 24px; color: #333; margin-bottom: 12px; }
        p { color: #666; font-size: 14px; line-height: 1.6; }
        .btn { display: inline-block; margin-top: 24px; padding: 10px 24px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.2s; }
        .btn:hover { background-color: #5a6268; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">✕</div>
        <h1>決済が完了していません</h1>
        <p>お支払手続きが中断されたか、キャンセルされました。<br>もう一度お試しいただくか、担当者にお問い合わせください。</p>
        <a href="/" class="btn">元の画面へ戻る</a>
    </div>
</body>
</html>