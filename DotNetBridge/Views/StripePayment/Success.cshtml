@{
    Layout = null;
    var sessionId = Context.Request.Query["session_id"].ToString();
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>お支払い完了</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="card shadow-lg border-0 text-center p-4 m-3" style="max-width: 420px; border-radius: 16px;">
        <div class="card-body">
            <div class="text-success mb-3">
                <i class="bi bi-check-circle-fill" style="font-size: 4.5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">お支払い完了</h3>
            <p class="text-muted mb-3">クレジットカードでの決済が正常に完了いたしました。<br>ご協力ありがとうございました。</p>

            @if (!string.IsNullOrEmpty(sessionId))
            {
                <div class="bg-light p-3 rounded mb-4 border text-start">
                    <div class="text-muted small fw-bold mb-1">
                        <i class="bi bi-receipt me-1"></i>決済お問い合わせID
                    </div>
                    <div class="font-monospace text-break small text-secondary">@sessionId</div>
                </div>
            }

            <button onclick="window.close()" class="btn btn-success btn-lg w-100 shadow-sm rounded-pill">
                <i class="bi bi-x-circle me-1"></i>画面を閉じる
            </button>
        </div>
    </div>
</body>
</html>